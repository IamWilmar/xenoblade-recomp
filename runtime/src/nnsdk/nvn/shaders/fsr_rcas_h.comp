#version 450
// FSR 1 RCAS en media precisión (FFX_HALF): como fsr_rcas.comp, en FP16.
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 64) in;
layout(push_constant) uniform Const { uvec4 con0; };
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
#define A_GPU 1
#define A_GLSL 1
#define A_HALF 1
#include "ffx_a.h"
#define FSR_RCAS_H 1
AH4 FsrRcasLoadH(ASW2 p) { return AH4(texelFetch(source, ASU2(p), 0)); }
void FsrRcasInputH(inout AH1 r, inout AH1 g, inout AH1 b) {}
#include "ffx_fsr1.h"
void sample_at(AU2 pos) {
    AH3 c;
    FsrRcasH(c.r, c.g, c.b, pos, con0);
    imageStore(target, ASU2(pos), AF4(AF3(c), 1.0));
}
void main() {
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    sample_at(p);
    p.x += 8u;
    sample_at(p);
    p.y += 8u;
    sample_at(p);
    p.x -= 8u;
    sample_at(p);
}
