#version 450
// Como fsr_rcas_up.comp (RCAS sobre la entrada escalada con el filtro lineal, sin EASU), en media precisión (FFX_HALF).
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 64) in;
// con1: uv de la entrada por píxel de salida (xy) y el uv máximo de la zona que se escala (zw).
layout(push_constant) uniform Const { uvec4 con0; vec4 con1; };
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
#define A_GPU 1
#define A_GLSL 1
#define A_HALF 1
#include "ffx_a.h"
#define FSR_RCAS_H 1
AH4 FsrRcasLoadH(ASW2 p) { return AH4(textureLod(source, min((vec2(ASU2(p)) + 0.5) * con1.xy, con1.zw), 0.0)); }
void FsrRcasInputH(inout AH1 r, inout AH1 g, inout AH1 b) {}
#include "ffx_fsr1.h"
void sample_at(AU2 pos) {
    AH3 c;
    FsrRcasH(c.r, c.g, c.b, pos, con0);
    imageStore(target, ASU2(pos), AF4(AF3(c), 1.0));
}
void main() {
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    sample_at(p);
    p.x += 8u;
    sample_at(p);
    p.y += 8u;
    sample_at(p);
    p.x -= 8u;
    sample_at(p);
}
