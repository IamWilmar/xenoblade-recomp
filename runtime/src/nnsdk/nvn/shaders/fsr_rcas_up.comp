#version 450
// RCAS (FSR 1, AMD FidelityFX, MIT) sobre la entrada escalada con el filtro lineal del sampler, sin EASU: cada texel que
// pide RCAS es una muestra bilineal de la entrada en el centro de ese píxel de salida. Una sola pasada, para cuando el FSR
// entero no cabe en el frame.
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 64) in;
// con1: uv de la entrada por píxel de salida (xy) y el uv máximo de la zona que se escala (zw).
layout(push_constant) uniform Const { uvec4 con0; vec4 con1; };
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return textureLod(source, min((vec2(p) + 0.5) * con1.xy, con1.zw), 0.0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"
void sample_at(AU2 pos) {
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, pos, con0);
    imageStore(target, ASU2(pos), AF4(c, 1.0));
}
void main() {
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    sample_at(p);
    p.x += 8u;
    sample_at(p);
    p.y += 8u;
    sample_at(p);
    p.x -= 8u;
    sample_at(p);
}
