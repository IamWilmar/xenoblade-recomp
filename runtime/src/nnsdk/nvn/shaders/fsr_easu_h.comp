#version 450
// FSR 1 EASU en media precisión (FFX_HALF): lo mismo que fsr_easu.comp con la aritmética en FP16 (el Adreno 650 hace
// el doble de FP16 por ciclo). Las coordenadas siguen en FP32 (FsrEasuH las calcula así); solo el filtro va en FP16.
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 64) in;
layout(push_constant) uniform Const { uvec4 con0, con1, con2, con3; };
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
#define A_GPU 1
#define A_GLSL 1
#define A_HALF 1
#include "ffx_a.h"
#define FSR_EASU_H 1
AH4 FsrEasuRH(AF2 p) { return AH4(textureGather(source, p, 0)); }
AH4 FsrEasuGH(AF2 p) { return AH4(textureGather(source, p, 1)); }
AH4 FsrEasuBH(AF2 p) { return AH4(textureGather(source, p, 2)); }
#include "ffx_fsr1.h"
void sample_at(AU2 pos) {
    AH3 c;
    FsrEasuH(c, pos, con0, con1, con2, con3);
    imageStore(target, ASU2(pos), AF4(AF3(c), 1.0));
}
void main() {
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    sample_at(p);
    p.x += 8u;
    sample_at(p);
    p.y += 8u;
    sample_at(p);
    p.x -= 8u;
    sample_at(p);
}
