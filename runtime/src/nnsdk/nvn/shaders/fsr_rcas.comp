#version 450
// FSR 1 RCAS (AMD FidelityFX, MIT): nitidez adaptativa sobre la salida de EASU.
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 64) in;
layout(push_constant) uniform Const { uvec4 con0; };
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(source, p, 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"
void sample_at(AU2 pos) {
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, pos, con0);
    imageStore(target, ASU2(pos), AF4(c, 1.0));
}
void main() {
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    sample_at(p);
    p.x += 8u;
    sample_at(p);
    p.y += 8u;
    sample_at(p);
    p.x -= 8u;
    sample_at(p);
}
