+// El programa que recorre TexturePass, para buscar en todo él (TrackLocal).
+thread_local const IR::Program* t_program{nullptr};
+
+// Un handle que el shader guarda en su memoria local y vuelve a leer (GLSLC lo hace con las texturas que un material de
+// Unreal Engine 5 mete en una estructura local): se siguen las escrituras a esa misma palabra. Vale si todas las del
+// programa guardan el mismo handle seguible y ninguna escritura va a una posición calculada (podría pisar esa palabra).
+std::optional<ConstBufferAddr> TrackLocal(const IR::Value& handle, Environment& env,
+                                          const HostTranslateInfo& host_info, std::string* why) {
+    if (handle.IsImmediate() || !t_program) {
+        return std::nullopt;
+    }
+    const IR::Inst* const load{handle.InstRecursive()};
+    if (load->GetOpcode() != IR::Opcode::LoadLocal || !load->Arg(0).IsImmediate()) {
+        return std::nullopt;
+    }
+    const u32 offset{load->Arg(0).U32()};
+    std::optional<ConstBufferAddr> found;
+    u32 writes{};
+    for (IR::Block* const other : t_program->post_order_blocks) {
+        for (IR::Inst& write : other->Instructions()) {
+            if (write.GetOpcode() != IR::Opcode::WriteLocal) {
+                continue;
+            }
+            if (!write.Arg(0).IsImmediate()) {
+                *why = "escritura local a una posición calculada";
+                return std::nullopt;
+            }
+            if (write.Arg(0).U32() != offset) {
+                continue;
+            }
+            writes++;
+            const std::optional<ConstBufferAddr> addr{Track(write.Arg(1), env, host_info, other)};
+            if (!addr || addr->count != 1 || !addr->dynamic_offset.IsEmpty()) {
+                *why = fmt::format("la escritura {} a la palabra local {:#x} no se sigue", writes, offset);
+                return std::nullopt;
+            }
+            if (found && (found->index != addr->index || found->offset != addr->offset ||
+                          found->shift_left != addr->shift_left || found->has_secondary != addr->has_secondary ||
+                          found->secondary_index != addr->secondary_index ||
+                          found->secondary_offset != addr->secondary_offset ||
+                          found->secondary_shift_left != addr->secondary_shift_left ||
+                          found->and_mask != addr->and_mask || found->or_imm != addr->or_imm)) {
+                *why = fmt::format("la palabra local {:#x} recibe handles distintos (c{}[{:#x}] y c{}[{:#x}])", offset,
+                                   found->index, found->offset, addr->index, addr->offset);
+                return std::nullopt;
+            }
+            found = addr;
+        }
+    }
+    if (!found) {
+        *why = fmt::format("nadie escribe la palabra local {:#x}", offset);
+    }
+    return found;
+}
